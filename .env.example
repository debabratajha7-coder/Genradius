# MongoDB Atlas / local
# Example Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/genradius
MONGODB_URI=mongodb://127.0.0.1:27017/genradius

# Set false once Mongo Atlas is connected (required for admin writes + checkout)
USE_MEMORY_CATALOG=false

# Admin panel (/admin) — bootstrap owner (created/synced on login when DB has no admins)
# ADMIN_PHONE must be real E.164 digits (e.g. +9198XXXXXXXX) — placeholders like XXXX block login
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-string-for-jwt
ADMIN_EMAIL=owner@genradius.in
ADMIN_PHONE=+919876543210

# Cloudinary (image uploads from admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer auth
AUTH_SECRET=long-random-string-for-customer-jwt

# Phone OTP (Twilio Verify preferred)
# Without these, OTP works in mock mode with code 123456
# If Twilio is configured, COD checkout requires OTP matching shipping phone
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional SMS fallback if Verify SID is empty:
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Google OAuth (Continue with Google)
# Create at https://console.cloud.google.com/apis/credentials
# Local redirect:  http://localhost:3000/api/auth/google/callback
# Production:      https://www.genradius.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL (PhonePe redirects + webhook docs)
# Local: http://localhost:3000
# Production: https://www.genradius.in
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional alias used by some helpers:
# SITE_URL=https://www.genradius.in

# Resend (order confirm / cancel / shipping + newsletter)
# https://resend.com/api-keys
RESEND_API_KEY=
# Must match a verified domain in Resend (genradius.in)
RESEND_FROM=Genradius <info@genradius.in>
# EMAIL_FROM=Genradius <info@genradius.in>

# ─── PhonePe Payment Gateway ───────────────────────────────────────────────
# https://developer.phonepe.com — Standard Checkout (OAuth client credentials)
# Sandbox keys → PHONEPE_ENV=sandbox | Production keys → PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox

# Webhook auth (required when PHONEPE_ENV=production)
# PhonePe Authorization header = SHA256 hex of "USERNAME:PASSWORD"
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Dashboard webhook URL (paste in PhonePe):
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/phonepe
# Example: https://www.genradius.in/api/webhooks/phonepe
# Redirect after pay: {NEXT_PUBLIC_APP_URL}/checkout/success?order_id={orderNumber}

# ─── Shiprocket fulfillment ────────────────────────────────────────────────
# https://app.shiprocket.in — API user email/password
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location NAME must match Shiprocket dashboard exactly (not a street address)
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: used only if you later enable live rate shopping
SHIPROCKET_PICKUP_PINCODE=
# Webhook token — set the same value in Shiprocket webhook settings
SHIPROCKET_WEBHOOK_TOKEN=
# Dashboard webhook URL (paste in Shiprocket):
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/fulfillment
# Example: https://www.genradius.in/api/webhooks/fulfillment
# Auth: x-api-key header, Authorization: Bearer <token>, or ?token=

# Admin-tunable fees (also editable at /admin/settings — not secrets):
# freeShippingThreshold=1000, shippingFee=99, codFee=49, codEnabled, pickupLocationName
