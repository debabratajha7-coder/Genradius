# MongoDB Atlas / local
# Example Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/genradius
MONGODB_URI=mongodb://127.0.0.1:27017/genradius

# Set false once Mongo Atlas is connected (required for admin writes)
USE_MEMORY_CATALOG=false

# Admin panel (/admin) — bootstrap owner (created/synced on login when DB has no admins)
# ADMIN_PHONE must be real E.164 digits (e.g. +9198XXXXXXXX) — placeholders like XXXX block login
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-string-for-jwt
ADMIN_EMAIL=owner@genradius.in
ADMIN_PHONE=+919876543210

# Cloudinary (image uploads from admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer auth
AUTH_SECRET=long-random-string-for-customer-jwt

# Phone OTP (Twilio Verify preferred)
# Without these, OTP works in mock mode with code 123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional SMS fallback if Verify SID is empty:
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Google OAuth (Continue with Google)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional public site URL (defaults to https://genradius.in for SEO/sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (footer newsletter + admin drop emails)
# https://resend.com/api-keys
RESEND_API_KEY=
# Must match a verified domain in Resend (you verified genradius.in)
RESEND_FROM=Genradius <info@genradius.in>

# PhonePe Payment Gateway (sandbox until PHONEPE_ENV=production)
# https://developer.phonepe.com
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox

# Shiprocket delivery
# Pickup location name must match a location in the Shiprocket dashboard
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_PICKUP_LOCATION=Primary

